{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/autonomous-sdlc/governance/plan-schema.json",
  "title": "Autonomous SDLC Plan",
  "description": "Machine-readable contract for a change proposal that requires user acceptance before implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "problem",
    "desired_outcome",
    "scope",
    "out_of_scope",
    "acceptance_criteria",
    "test_strategy",
    "risk_class",
    "data_classification",
    "affected_paths",
    "dependencies_added",
    "rollback",
    "observability",
    "required_approvals"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PLAN-[0-9]{4,}$",
      "description": "Stable identifier for the plan."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "desired_outcome": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "test_ref"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]{1,3}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "test_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "test_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["levels", "coverage_target", "mutation_testing"],
      "properties": {
        "levels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["unit", "integration", "contract", "e2e", "performance", "security"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "coverage_target": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "mutation_testing": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "risk_class": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "data_classification": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "regulated"]
    },
    "affected_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "dependencies_added": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "reason"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9@_./-]+$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "verification"],
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "logs", "alerts"],
      "properties": {
        "metrics": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "logs": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "alerts": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "required_approvals": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["business_owner", "engineering", "security", "architecture", "compliance", "privacy"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "security_review": {
      "$ref": "#/$defs/security_review"
    },
    "adr_ref": {
      "type": "string",
      "pattern": "^docs/adr/[0-9]{4}-[a-z0-9-]+\\.md$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "risk_class": {
            "enum": ["high", "critical"]
          }
        }
      },
      "then": {
        "required": ["adr_ref"]
      }
    },
    {
      "if": {
        "properties": {
          "data_classification": {
            "enum": ["confidential", "regulated"]
          }
        }
      },
      "then": {
        "required": ["security_review"]
      }
    }
  ],
  "$defs": {
    "security_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threat_model", "required_controls"],
      "properties": {
        "threat_model": {
          "type": "string",
          "minLength": 1
        },
        "required_controls": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
